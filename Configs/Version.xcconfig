// The app's version, shared by every target — the App Store wants the widget
// extension's to match the app's, so it lives here once, not per target.
//
//   MARKETING_VERSION        what people see (semver), set by hand per release
//   CURRENT_PROJECT_VERSION  the build number: the commit count at the release,
//                            so it only ever grows (TestFlight's one rule)
//
// Change both through `scripts/release.sh <version>`, which also commits and
// tags; a hand edit here is a release without its tag.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 0
