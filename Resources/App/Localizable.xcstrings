    "settings:memory.settings.freshTailSize.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der neuesten Durchläufe – eine Nachricht von dir mit jedem Modellschritt und Werkzeugergebnis, das sie beantwortet hat –, die von der Komprimierung ausgenommen sind (2–24). Sie werden dem Modell immer unverändert gesendet. Standard: 6."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number of recent runs — a message of yours with every model step and tool result that answered it — protected from compaction (2-24). They are always sent to the model verbatim. Default: 6."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de ejecuciones recientes (un mensaje tuyo con cada paso del modelo y resultado de herramienta que lo respondió) protegidas de la compactación (2-24). Siempre se envían al modelo tal cual. Predeterminado: 6."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d'exécutions récentes — un de vos messages avec chaque étape du modèle et résultat d'outil qui y a répondu — protégées du compactage (2 à 24). Elles sont toujours envoyées au modèle telles quelles. Par défaut : 6."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di esecuzioni recenti — un tuo messaggio con ogni passaggio del modello e risultato di strumento che gli ha risposto — protette dalla compattazione (2-24). Vengono sempre inviate al modello così come sono. Predefinito: 6."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圧縮から保護される直近のラン数（2〜24）。ランとは、あなたのメッセージ 1 件と、それに応答したモデルの各ステップおよびツール結果のことです。これらは常にそのままモデルに送信されます。デフォルト: 6。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "압축에서 제외되는 최근 실행 수(2~24)입니다. 실행이란 사용자의 메시지 하나와 그에 응답한 모든 모델 단계 및 도구 결과를 말합니다. 이 실행은 항상 모델에 그대로 전송됩니다. 기본값: 6."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de execuções recentes — uma mensagem sua com cada etapa do modelo e resultado de ferramenta que a respondeu — protegidas contra compactação (2-24). Elas são sempre enviadas ao modelo sem alterações. Padrão: 6."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不受壓縮影響的最近回合數量（2-24）。一個回合是你的一則訊息，連同回應它的每一個模型步驟和工具結果。這些回合會一律以原文傳送給模型。預設值：6。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不受壓縮影響的最近回合數量（2-24）。一個回合是你的一則訊息，連同回應它的每一個模型步驟和工具結果。這些回合永遠會原樣傳送給模型。預設值：6。"
          }
        }
      }
    },
