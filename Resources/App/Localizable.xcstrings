    "settings:memory.settings.useInChat.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet die für Ihre Nachricht relevanten Gedächtniseinträge zu Beginn einer Antwort in den Kontext des Assistenten ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surface the memory entries relevant to your message into the assistant's context at the start of a reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar las entradas de memoria relevantes para su mensaje en el contexto del asistente al comenzar una respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait remonter les entrées de mémoire pertinentes pour votre message dans le contexte de l'assistant au début d'une réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta in evidenza nel contesto dell'assistente le voci di memoria pertinenti al tuo messaggio, all'inizio di una risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージに関連するメモリーのエントリを、応答の開始時にアシスタントのコンテキストに反映します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답을 시작할 때 메시지와 관련된 메모리 항목을 어시스턴트의 컨텍스트에 반영합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trazer as entradas de memória relevantes para sua mensagem ao contexto do assistente no início de uma resposta."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在回覆開始時，將與你的訊息相關的記憶項目帶入助理的內容脈絡中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在回覆開始時，將與你的訊息相關的記憶項目帶入助理的內容脈絡中。"
          }
        }
      }
    },
