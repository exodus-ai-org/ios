    "ios:health.noData.explain" : {
      "comment" : "Health home: explains why there is no data.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ist noch nichts. Für Schlaf braucht es eine Apple Watch oder den Schlafmodus; vielleicht darf Exodus Health auch nicht lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing here yet. Sleep needs an Apple Watch or a Sleep Focus; it may also be that Exodus isn't allowed to read Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada. El sueño necesita un Apple Watch o el modo Sueño; también puede que Exodus no tenga permiso para leer Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien pour l'instant. Le sommeil nécessite une Apple Watch ou le mode Sommeil ; il se peut aussi qu'Exodus n'ait pas accès à Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente. Il sonno richiede un Apple Watch o la modalità Sonno; potrebbe anche darsi che Exodus non possa leggere Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだデータがありません。睡眠には Apple Watch か睡眠集中モードが必要です。Exodus にヘルスケアの読み取りが許可されていない可能性もあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 데이터가 없어요. 수면 기록에는 Apple Watch나 수면 집중 모드가 필요해요. Exodus에 건강 앱 읽기 권한이 없을 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
