    "Connect to the server and load its settings before saving." : {
      "comment" : "Error shown when saving is attempted before the server's settings were loaded.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinden Sie sich mit dem Server und laden Sie dessen Einstellungen, bevor Sie speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctese al servidor y cargue su configuración antes de guardar."
