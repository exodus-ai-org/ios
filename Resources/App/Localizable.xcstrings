    "ios:health.recovery.disclaimer" : {
      "comment" : "Recovery detail: not a medical assessment.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verglichen mit deinem Normalwert – keine medizinische Einschätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compared with your own usual — not a medical assessment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
