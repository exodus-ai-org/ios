    "settings:memory.settings.contextWindowPercent.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst die Kontextkomprimierung aus, sobald die Unterhaltung diesen Prozentsatz des Kontextfensters des Modells erreicht (50-95 %). Standard: 75 %."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger context compaction when the conversation reaches this percentage of the model's context window (50-95%). Default: 75%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active la compactación de contexto cuando la conversación alcance este porcentaje de la ventana de contexto del modelo (50-95 %). Predeterminado: 75 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déclenche le compactage du contexte lorsque la conversation atteint ce pourcentage de la fenêtre de contexte du modèle (50 à 95 %). Par défaut : 75 %."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la compattazione del contesto quando la conversazione raggiunge questa percentuale della finestra di contesto del modello (50-95%). Predefinito: 75%."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話がモデルのコンテキストウィンドウのこの割合(50〜95%)に達すると、コンテキストの圧縮を実行します。デフォルト: 75%。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 모델 컨텍스트 윈도우의 이 비율(50~95%)에 도달하면 컨텍스트 압축을 실행합니다. 기본값: 75%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acionar a compactação de contexto quando a conversa atingir esta porcentagem da janela de contexto do modelo (50-95%). Padrão: 75%."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當對話達到模型內容視窗的此百分比（50-95%）時，觸發內容壓縮。預設值：75%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當對話達到模型內容視窗的此百分比（50-95%）時，觸發內容壓縮。預設值：75%。"
          }
        }
      }
    },
