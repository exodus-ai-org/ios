    "ios:health.report.consentPrompt" : {
      "comment" : "Health report card: asks leave to write notes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ody kann dir mit dem KI-Anbieter auf deinem Computer eine kurze Notiz zu deinem Tag schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ody can write you a short note about your day using the AI provider on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ody puede escribirte una nota breve sobre tu día con el proveedor de IA de tu ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
