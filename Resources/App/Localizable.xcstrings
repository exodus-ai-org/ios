    "ios:chat.readAloud.cannotPlay" : {
      "comment" : "Alert text when the speech audio is in a format the phone cannot play (Opus, raw PCM).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Telefon kann das vom Computer gesendete Audio nicht abspielen. Wähle in den Einstellungen des Computers unter „Stimme“ MP3, AAC, WAV oder FLAC."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone cannot play the audio the computer sent. Choose MP3, AAC, WAV or FLAC in the computer’s Settings → Voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono no puede reproducir el audio que envió el ordenador. Elige MP3, AAC, WAV o FLAC en Ajustes → Voz del ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone ne peut pas lire l’audio envoyé par l’ordinateur. Choisissez MP3, AAC, WAV ou FLAC dans Réglages → Voix sur l’ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono non può riprodurre l’audio inviato dal computer. Scegli MP3, AAC, WAV o FLAC in Impostazioni → Voce sul computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでは、コンピュータから送られた音声を再生できません。コンピュータの「設定 → 音声」でMP3、AAC、WAV、FLACのいずれかを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 휴대전화에서는 컴퓨터가 보낸 오디오를 재생할 수 없습니다. 컴퓨터의 설정 → 음성에서 MP3, AAC, WAV 또는 FLAC를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este telefone não consegue reproduzir o áudio enviado pelo computador. Escolha MP3, AAC, WAV ou FLAC em Ajustes → Voz no computador."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部手機無法播放電腦傳來的音訊。請在電腦的「設定 → 語音」中選擇 MP3、AAC、WAV 或 FLAC。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部手機無法播放電腦送來的音訊。請在電腦的「設定 → 語音」中選擇 MP3、AAC、WAV 或 FLAC。"
          }
        }
      }
    },
