          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將這部 iPhone 與電腦上的 Exodus 配對：在電腦上開啟「設定 → 裝置」，然後選擇「配對裝置」。"
