        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave guardada solo funciona con la dirección para la que se guardó. Vuelva a introducir la clave para usar esta dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé enregistrée ne fonctionne qu’avec l’adresse pour laquelle elle a été enregistrée. Saisissez à nouveau la clé pour utiliser cette adresse."
