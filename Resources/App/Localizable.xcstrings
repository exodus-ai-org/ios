    "Allow Exodus to use the camera in Settings, or paste the pairing link instead." : {
      "comment" : "Alert message under 'Camera access is off'. Exodus is the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Exodus in den Einstellungen den Kamerazugriff oder fügen Sie stattdessen den Kopplungslink ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Exodus use la cámara en Ajustes o pega el enlace de vinculación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Exodus à utiliser l’appareil photo dans les Réglages, ou collez le lien de jumelage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Exodus di usare la fotocamera nelle Impostazioni, oppure incolla il link di abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」で Exodus にカメラの使用を許可するか、代わりにペアリングリンクをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Exodus의 카메라 사용을 허용하거나, 대신 페어링 링크를 붙여넣으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Exodus use a câmera nos Ajustes ou cole o link de pareamento."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Exodus 使用相機，或改為貼上配對連結。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Exodus 使用相機，或改為貼上配對連結。"
          }
        }
      }
    },
