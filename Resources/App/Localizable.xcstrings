    "settings:memory.settings.lcmEnabled.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komprimiert lange Unterhaltungen automatisch zu einem hierarchischen Zusammenfassungs-DAG, sodass nichts verloren geht, selbst wenn Chats das Kontextfenster überschreiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically compress long conversations into a hierarchical summary DAG, so nothing is ever lost even when chats exceed the context window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprima automáticamente las conversaciones largas en un resumen jerárquico en forma de DAG, de modo que nunca se pierda nada, incluso cuando los chats superen la ventana de contexto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compresse automatiquement les longues conversations en un DAG hiérarchique de résumés, afin que rien ne soit jamais perdu même lorsque les conversations dépassent la fenêtre de contexte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprime automaticamente le conversazioni lunghe in un riepilogo gerarchico (DAG), così nulla va mai perso anche quando le chat superano la finestra di contesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い会話を階層的な要約DAGに自動圧縮し、チャットがコンテキストウィンドウを超えても情報が失われないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 대화를 계층적 요약 DAG로 자동 압축하여, 채팅이 컨텍스트 윈도우를 초과해도 아무 정보도 손실되지 않도록 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprime automaticamente conversas longas em um resumo hierárquico em DAG, para que nada se perca mesmo quando os chats excedem a janela de contexto."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動將長對話壓縮成階層式摘要 DAG，即使聊天超出模型的內容視窗，亦不會遺失任何資訊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動將長對話壓縮成階層式摘要 DAG，即使聊天超出模型的內容視窗，也不會遺失任何資訊。"
          }
        }
      }
    },
