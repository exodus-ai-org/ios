    "ios:settings.memory.appliesToComputer" : {
      "comment" : "Footer under the Memory switches in Settings → Memory.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedächtniseinträge werden auf Ihrem Computer gespeichert und in jedem Chat verwendet, auf diesem Telefon wie auf dem Desktop."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memories are kept on your computer and used in every chat, on this phone and on the desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las memorias se guardan en tu ordenador y se usan en todos los chats, en este teléfono y en el escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mémoires sont conservées sur votre ordinateur et utilisées dans chaque conversation, sur ce téléphone comme sur l'ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le memorie sono conservate sul tuo computer e usate in ogni chat, su questo telefono e sul desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリーはコンピュータに保存され、このスマートフォンでもデスクトップでも、すべてのチャットで使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리는 컴퓨터에 저장되며 이 휴대폰과 데스크톱의 모든 채팅에서 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As memórias ficam salvas no seu computador e são usadas em todos os chats, neste celular e no desktop."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶儲存在你的電腦上，會用在每一段聊天中，無論是在這部手機還是桌面版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶儲存在你的電腦上，會用在每一段聊天中，無論是在這支手機還是桌面版。"
          }
        }
      }
    },
    "ios:settings.memory.deleteMessage" : {
      "comment" : "Message of the confirmation before a memory entry is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird endgültig von Ihrem Computer entfernt. Um ihn zu behalten, aber nicht mehr in Chats zu verwenden, deaktivieren Sie ihn stattdessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is removed from your computer for good. To keep it but stop using it in chats, disable it instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará de tu ordenador de forma permanente. Para conservarla sin usarla en los chats, desactívala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sera supprimée définitivement de votre ordinateur. Pour la conserver sans l'utiliser dans les conversations, désactivez-la plutôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà rimossa definitivamente dal tuo computer. Per conservarla senza usarla nelle chat, disattivala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータから完全に削除されます。残したままチャットで使わないようにするには、代わりに無効化してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 영구적으로 삭제됩니다. 보관하되 채팅에서 사용하지 않으려면 대신 비활성화하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela será removida do seu computador para sempre. Para mantê-la sem usá-la nos chats, desative-a."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這則記憶會從你的電腦上永久刪除。若想保留但不在聊天中使用，請改為停用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這則記憶會從你的電腦上永久刪除。若想保留但不在聊天中使用，請改為停用。"
          }
        }
      }
    },
