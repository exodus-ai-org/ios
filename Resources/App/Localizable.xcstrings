          }
        }
      }
    },
    "ios:settings.error.unreadableColumn" : {
      "comment" : "Error on a Settings page whose stored settings the phone cannot decode; nothing is written.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen sind auf Ihrem Computer in einer Form gespeichert, die diese App nicht lesen kann, daher wurden sie nicht geändert. Bearbeiten Sie sie auf Ihrem Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These settings are stored on your computer in a form this app can't read, so they were left unchanged. Edit them on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes están guardados en tu ordenador en un formato que esta app no puede leer, así que no se han modificado. Edítalos en tu ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages sont enregistrés sur votre ordinateur sous une forme que cette app ne peut pas lire ; ils n'ont donc pas été modifiés. Modifiez-les sur votre ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni sono salvate sul computer in un formato che questa app non riesce a leggere, quindi non sono state modificate. Modificale sul computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの設定はこのアプリで読み取れない形式でコンピュータに保存されているため、変更されていません。コンピュータで編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 이 앱이 읽을 수 없는 형식으로 컴퓨터에 저장되어 있어 변경되지 않았습니다. 컴퓨터에서 편집하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas configurações estão salvas no seu computador em um formato que este app não consegue ler, por isso não foram alteradas. Edite-as no computador."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些設定以本 App 無法讀取的格式儲存在你的電腦上，因此沒有更改。請在電腦上編輯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些設定以本 App 無法讀取的格式儲存在你的電腦上，因此未作變更。請在電腦上編輯。"
          }
        }
      }
    },
