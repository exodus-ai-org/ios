    "ios:health.onboarding.body" : {
      "comment" : "Health onboarding, step 1 body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf-, Aktivitäts-, Herz- und Körperdaten bleiben auf diesem iPhone. Nur eine kurze tägliche Zusammenfassung geht an deinen Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep, activity, heart and body data stay on this iPhone. Only a short daily summary is ever sent to your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de sueño, actividad, corazón y cuerpo se quedan en este iPhone. Solo se envía a tu ordenador un breve resumen diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommeil, activité, cœur et corps restent sur cet iPhone. Seul un court résumé quotidien est envoyé à ton ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati su sonno, attività, cuore e corpo restano su questo iPhone. Al tuo computer arriva solo un breve riepilogo giornaliero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠、アクティビティ、心臓、体のデータはこの iPhone に残ります。コンピュータに送られるのは毎日の短い要約だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면, 활동, 심장, 신체 데이터는 이 iPhone에만 남아요. 컴퓨터로는 하루 한 번 짧은 요약만 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados de sono, atividade, coração e corpo ficam neste iPhone. Só um resumo diário curto vai para o seu computador."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠、活動、心臟同身體資料都會留喺呢部 iPhone。淨係每日一份簡短摘要會傳去你部電腦。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠、活動、心臟與身體資料都留在這部 iPhone 上。只有每日一份簡短摘要會傳到你的電腦。"
          }
        }
      }
    },
