    "ios:settings.backup.onComputer" : {
      "comment" : "Footer of the Backups section.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen werden auf Ihrem Computer erstellt und dort aufbewahrt. Tägliche Sicherungen schalten Sie dort ein oder aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups are made and kept on your computer. Switch daily backups on or off there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se crean y se guardan en tu ordenador. Activa o desactiva allí las copias diarias."
