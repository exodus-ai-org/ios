    "settings:memory.settings.autoCapture.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst nach jeder Unterhaltung dauerhafte Fakten über Sie (Interessen, Einrichtung, Personen) im Gedächtnis zusammen — bestehende Einträge werden aktualisiert, statt sie zu duplizieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After each conversation, consolidate durable facts about you (interests, setup, people) into memory — updating existing entries rather than duplicating them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de cada conversación, consolide los datos duraderos sobre usted (intereses, configuración, personas) en la memoria, actualizando las entradas existentes en lugar de duplicarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après chaque conversation, consolide en mémoire les faits durables vous concernant (centres d'intérêt, configuration, personnes) — en mettant à jour les entrées existantes plutôt qu'en les dupliquant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo ogni conversazione, consolida in memoria i fatti duraturi su di te (interessi, configurazione, persone) — aggiornando le voci esistenti anziché duplicarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各会話の後、あなたに関する永続的な事実(興味、環境、人物など)を重複させることなく既存のエントリを更新しながらメモリーに統合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 끝날 때마다 당신에 대한 지속적인 사실(관심사, 설정, 사람)을 메모리로 통합합니다 — 중복 생성 대신 기존 항목을 업데이트합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após cada conversa, consolidar fatos duradouros sobre você (interesses, configuração, pessoas) na memória — atualizando entradas existentes em vez de duplicá-las."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次對話結束後，將關於你的持久事實（興趣、設定、相關人物）整合進記憶——更新現有項目，而非重複建立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次對話結束後，將關於你的持久性事實（興趣、環境設定、相關人物）整合進記憶中——更新既有項目，而非重複建立。"
          }
        }
      }
    },
