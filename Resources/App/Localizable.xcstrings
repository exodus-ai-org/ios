    "ios:settings.pairing.instructions" : {
      "comment" : "Settings → Computer, shown while unpaired. 'Settings → Devices' and 'Pair a device' are the desktop app's labels.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppeln Sie dieses iPhone mit Exodus auf Ihrem Computer: Öffnen Sie dort Einstellungen → Geräte und wählen Sie „Gerät koppeln“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair this iPhone with Exodus on your computer: open Settings → Devices there and choose Pair a device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula este iPhone con Exodus en tu ordenador: abre allí Ajustes → Dispositivos y elige Vincular un dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumelez cet iPhone avec Exodus sur votre ordinateur : ouvrez-y Réglages → Appareils et choisissez Jumeler un appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbina questo iPhone a Exodus sul tuo computer: apri lì Impostazioni → Dispositivi e scegli Abbina un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone をコンピュータの Exodus とペアリングします。コンピュータ側で「設定 → デバイス」を開き、「デバイスをペアリング」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone을 컴퓨터의 Exodus와 페어링하세요. 컴퓨터에서 ‘설정 → 기기’를 열고 ‘기기 페어링’을 선택하면 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
