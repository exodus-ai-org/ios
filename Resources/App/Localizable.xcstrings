          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡還沒有資料。睡眠需要 Apple Watch 或睡眠專注模式；也可能是 Exodus 沒有讀取健康 App 的權限。"
          }
        }
      }
    },
