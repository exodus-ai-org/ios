        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga una copia de seguridad de sus datos todos los días a las 3:00 a. m. Las copias se guardan localmente en ~/.exodus/backups/."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
