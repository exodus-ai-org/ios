    "settings:dataControls.autoBackup.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert Ihre Daten täglich um 3:00 Uhr. Backups werden lokal unter ~/.exodus/backups/ gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
