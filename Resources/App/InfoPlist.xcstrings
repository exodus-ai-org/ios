    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus liest deine Schlaf-, Aktivitäts-, Herz- und Körperdaten, um deinen täglichen Gesundheitsbericht zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus reads your sleep, activity, heart and body data to write your daily health report."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus lee tus datos de sueño, actividad, corazón y cuerpo para redactar tu informe de salud diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus lit vos données de sommeil, d'activité, de cœur et de corps pour rédiger votre bilan de santé quotidien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus legge i tuoi dati su sonno, attività, cuore e corpo per scrivere il tuo resoconto di salute giornaliero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus は、毎日のヘルスレポートを作成するために、睡眠、アクティビティ、心臓、身体のデータを読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus는 일일 건강 리포트를 작성하기 위해 수면, 활동, 심장 및 신체 데이터를 읽습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Exodus lê seus dados de sono, atividade, coração e corpo para escrever seu relatório de saúde diário."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會讀取你的睡眠、活動、心臟與身體資料，用嚟撰寫你嘅每日健康報告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會讀取你的睡眠、活動、心臟與身體資料，用來撰寫你的每日健康報告。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus speichert die Wassermenge, die du erfasst, in Apple Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus saves the water you log to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus guarda en Salud el agua que registras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus enregistre dans Santé l'eau que vous consignez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus salva in Salute l'acqua che registri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus は、記録した水分摂取量を「ヘルスケア」に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus는 기록한 물 섭취량을 건강 앱에 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Exodus salva no Saúde a água que você registra."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會將你記錄嘅飲水量儲存到「健康」App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會將你記錄的飲水量儲存到「健康」App。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local-network permission prompt. Exodus is the app's name and stays as is.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus benötigt Zugriff auf das lokale Netzwerk, um sich mit dem auf Ihrem Computer laufenden Exodus-Dienst zu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus needs local network access to connect to the Exodus service running on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus necesita acceso a la red local para conectarse al servicio de Exodus que se ejecuta en su equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus a besoin d'un accès au réseau local pour se connecter au service Exodus qui s'exécute sur votre ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus ha bisogno dell'accesso alla rete locale per connettersi al servizio Exodus in esecuzione sul tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodusは、お使いのコンピュータで動作しているExodusサービスに接続するために、ローカルネットワークへのアクセスを必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus가 컴퓨터에서 실행 중인 Exodus 서비스에 연결하려면 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Exodus precisa de acesso à rede local para se conectar ao serviço do Exodus em execução no seu computador."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 需要本地網絡存取權，才能連線到在你電腦上執行的 Exodus 服務。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 需要區域網路存取權，才能連線到在你電腦上執行的 Exodus 服務。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt. Exodus is the app's name and stays as is.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus verwendet deinen Standort, um deine Position auf der Routenkarte anzuzeigen und die Karte beim Tippen auf die Standorttaste dorthin zu zentrieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus uses your location to show your position on the itinerary map and center the map when you tap the location button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus usa tu ubicación para mostrar tu posición en el mapa del itinerario y centrarlo al tocar el botón de ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus utilise votre position pour l'afficher sur la carte de l'itinéraire et centrer la carte lorsque vous touchez le bouton de localisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus usa la tua posizione per mostrarla sulla mappa dell'itinerario e centrare la mappa quando tocchi il pulsante della posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus は、旅程マップに現在地を表示し、現在地ボタンをタップしたときに地図を現在地へ移動するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus는 일정 지도에 현재 위치를 표시하고 위치 버튼을 탭할 때 지도를 해당 위치로 이동하기 위해 위치 정보를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Exodus usa sua localização para mostrar sua posição no mapa do roteiro e centralizar o mapa quando você toca no botão de localização."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會使用你的位置，在行程地圖上顯示你的位置，並在你點按定位按鈕時將地圖移至該處。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會使用你的位置，在行程地圖上顯示你的位置，並在你點選定位按鈕時將地圖移至該處。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Photo library (add only) permission prompt, shown when saving a generated image. Exodus is the app's name and stays as is.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus speichert die von Ihnen ausgewählten Bilder in Ihrer Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus saves the images you choose to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus guarda en tu fototeca las imágenes que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus enregistre les images que vous choisissez dans votre photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus salva nella tua libreria foto le immagini che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus は選択した画像を写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus는 선택한 이미지를 사진 보관함에 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Exodus salva as imagens que você escolher na sua fototeca."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會把你選擇的圖片儲存到你的相片圖庫。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exodus 會把你選擇的圖片儲存到你的照片圖庫。"
          }
        }
      }
    }
  },
  "version" : "1.0"
